# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side Only (Optional for core web functionality)
SUPABASE_SECRET_KEY=sb_secret_...

# Azure Cognitive Services Speech (Required to regenerate audio assets)
# Get these from the Azure Portal → Speech resource → Keys and Endpoint.
# Only used by scripts/generate-audio.mjs at build time. Never shipped to the client.
AZURE_SPEECH_REGION=swedencentral
AZURE_SPEECH_KEY=your-azure-speech-key

# Optional voice overrides
AZURE_SPEECH_VOICE=sv-SE-SofieNeural
AZURE_SPEECH_RATE=-4%
AZURE_SPEECH_PITCH=+8%
AZURE_SPEECH_STYLE=cheerful
AZURE_SPEECH_STYLE_DEGREE=1.4
